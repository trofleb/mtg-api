# API Configuration
#
# Server-side only, and deliberately not NEXT_PUBLIC_*: the API is called from
# the Next.js server, never from the browser, so this value must not be inlined
# into the client bundle.
#
# In Docker this is set by docker-compose to the service name (http://api:8000).
# Running `pnpm dev` or the e2e suite outside Docker, point it at the published
# port instead.
API_URL=http://localhost:8000
