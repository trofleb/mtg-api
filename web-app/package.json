  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "openapi-typescript ../openapi.json -o lib/api-types.ts && biome format --write lib/api-types.ts",
    "test": "vitest --project unit",
    "test:run": "vitest run --project unit",
    "test:ui": "vitest --project unit --ui",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:browser:watch": "vitest --project browser",
    "test:all": "vitest run",
    "stub": "tsx e2e/stub/server.ts",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --project static",
    "test:e2e:stubbed": "playwright test --project stubbed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:ui": "playwright test --config playwright.live.config.ts --ui",
    "test:e2e:prod": "BASE_URL=https://mtg.nicocasa.ch playwright test --config playwright.live.config.ts",
    "test:e2e:ui:prod": "BASE_URL=https://mtg.nicocasa.ch playwright test --config playwright.live.config.ts --ui"
  },
