  "openapi": "3.1.0",
  "paths": {
    "/cards/id/{scryfall_id}": {
      "get": {
        "description": "Get a specific MTG card printing by Scryfall ID.\n\nArgs:\n    scryfall_id: Unique Scryfall UUID for a specific card printing\n    collection: MongoDB cards collection (injected dependency)\n\nReturns:\n    Card data including image_uris and all metadata\n\nRaises:\n    HTTPException: 404 if card not found",
        "operationId": "get_card_by_scryfall_id_cards_id__scryfall_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scryfall_id",
            "required": true,
            "schema": {
              "title": "Scryfall Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPrinting"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Card By Scryfall Id"
      }
    },
    "/cards/oracle/{oracle_id}": {
      "get": {
        "description": "Get all printings of a card by Oracle ID.\n\nArgs:\n    oracle_id: Oracle UUID representing the card concept (non-unique)\n    collection: MongoDB cards collection (injected dependency)\n\nReturns:\n    List of all card printings sharing this oracle_id\n\nRaises:\n    HTTPException: 404 if no cards found with this oracle_id",
        "operationId": "get_cards_by_oracle_id_cards_oracle__oracle_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "oracle_id",
            "required": true,
            "schema": {
              "title": "Oracle Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CardPrinting"
                  },
                  "title": "Response Get Cards By Oracle Id Cards Oracle  Oracle Id  Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Cards By Oracle Id"
      }
    },
    "/cards/oracle/{oracle_id}/aggregated": {
      "get": {
        "description": "Get a single card aggregated across all its printings, by Oracle ID.\n\n/cards/oracle/{oracle_id} returns the raw printings. This returns the same\ngrouped shape that /cards/search/{text} produces for each result, so a\ncard can be rendered on its own from an Oracle ID alone rather than only\nfrom a search result.\n\nArgs:\n    oracle_id: Oracle UUID representing the card concept\n    collection: MongoDB cards collection (injected dependency)\n\nReturns:\n    Aggregated card data, including every printing under \"cards\"\n\nRaises:\n    HTTPException: 404 if no cards found with this oracle_id",
        "operationId": "get_aggregated_card_by_oracle_id_cards_oracle__oracle_id__aggregated_get",
        "parameters": [
          {
            "in": "path",
            "name": "oracle_id",
            "required": true,
            "schema": {
              "title": "Oracle Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OracleCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Aggregated Card By Oracle Id"
      }
    },
